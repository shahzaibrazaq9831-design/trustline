# Copy this file to .env and fill in real, random values before running.
# NEVER commit the real .env file to git.

PORT=4000
NODE_ENV=development

# Origin allowed to call this API (your React app)
CLIENT_ORIGIN=http://localhost:5173

# --- Secrets: generate with `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"` ---

# Signs/verifies short-lived access tokens
JWT_ACCESS_SECRET=replace_with_a_64_byte_random_hex_string

# Signs/verifies longer-lived refresh tokens (stored in httpOnly cookie)
JWT_REFRESH_SECRET=replace_with_a_different_64_byte_random_hex_string

# AES-256-GCM key used to encrypt sensitive DB fields (account numbers, CNIC, etc).
# Must be exactly 32 bytes -> generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=replace_with_a_32_byte_random_hex_string

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
